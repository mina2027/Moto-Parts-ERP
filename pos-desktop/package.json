{
  "name": "moto-pos-desktop",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "MotoParts POS — offline-first desktop terminal",
  "main": "./out/main/index.js",
  "author": "MotoParts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && npm run test --workspaces --if-present",
    "rebuild": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:portable": "node scripts/dist.mjs portable"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@moto/api-client": "*",
    "@moto/pos-core": "*",
    "@moto/shared": "*",
    "@moto/ui": "*",
    "@tanstack/react-query": "^5.51.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.10.0",
    "lucide-react": "^0.424.0",
    "postcss": "^8.4.40",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "zustand": "^4.5.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
