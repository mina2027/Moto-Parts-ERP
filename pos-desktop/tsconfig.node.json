{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@main/*": ["src/main/*"] }
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "packages/shared/src/**/*.ts"],
  "exclude": ["src/main/**/*.test.ts"]
}
